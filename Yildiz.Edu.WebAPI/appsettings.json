{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "CookieAuthOptions": {
    "Name": "Security",
    "LoginPath": "/Auth/Login",
    "LogOutPath": "/Auth/LogOut",
    "AccessDeniedPath": "/Auth/Err",
    "SlidingExpiration": true,
    "TimeOut": 300 //saniye
  }
}
