<h3>Login</h3>
<form method="post" action="Login">
    @{
        if (ViewBag.message!=null)
        {
            <h4 class="text-danger">@ViewBag.message</h4>
        }
    }
    <div class="row">
        <div class="col-md-2">
            Username (Email)
        </div>
        <div class="col-md-3">
            <input type="text" name="email" class="form-control" value="@ViewBag.email" />
        </div>
    </div>
    <div class="row mt-1">
        <div class="col-md-2">
            Password
        </div>
        <div class="col-md-3">
            <input type="password" name="password" class="form-control" value="@ViewBag.password" />
        </div>
    </div>
    <div class="row mt-1">
        <div class="col-md-5">
            <input type="submit" class="btn btn-success float-end" value="Login"/>
        </div>
        
    </div>
  
</form>